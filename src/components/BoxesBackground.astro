<div class="hover-field" aria-hidden="true" data-hover-field>
  <canvas></canvas>
  <div class="field-vignette"></div>
</div>

<script>
  const field = document.querySelector('[data-hover-field]');
  const canvas = field?.querySelector('canvas');

  if (field instanceof HTMLElement && canvas instanceof HTMLCanvasElement) {
    const context = canvas.getContext('2d');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (context) {
      let width = 0;
      let height = 0;
      let running = true;
      let pointerX = -1000;
      let pointerY = -1000;
      let targetX = -1000;
      let targetY = -1000;
      let frameId = 0;
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);

      const resize = () => {
        const rect = field.getBoundingClientRect();
        width = Math.max(1, rect.width);
        height = Math.max(1, rect.height);
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        context.setTransform(dpr, 0, 0, dpr, 0, 0);
        if (reducedMotion) draw(0);
      };

      const draw = (time: number) => {
        context.clearRect(0, 0, width, height);
        pointerX += (targetX - pointerX) * 0.1;
        pointerY += (targetY - pointerY) * 0.1;

        const columns = Math.max(24, Math.round(width / 42));
        const rows = 22;
        const horizon = height * 0.06;
        const cursorRadius = Math.max(110, width * 0.13);

        for (let row = 0; row < rows; row += 1) {
          const depth = row / (rows - 1);
          const perspective = 0.44 + depth * 0.82;
          const y = horizon + Math.pow(depth, 1.65) * height * 0.9;

          for (let column = 0; column < columns; column += 1) {
            const across = column / (columns - 1) - 0.5;
            const x = width * 0.5 + across * width * perspective;
            const dx = x - pointerX;
            const dy = y - pointerY;
            const distance = Math.sqrt(dx * dx + dy * dy);
            const hover = Math.max(0, 1 - distance / cursorRadius);
            const ambient = reducedMotion ? 0 : (Math.sin(time * 0.0012 + column * 0.55 + row * 0.8) + 1) * 0.5;
            const intensity = Math.min(1, hover * hover * 1.5 + ambient * 0.12);
            const lineHeight = 2 + depth * 5 + intensity * 28;
            const lineWidth = 0.7 + depth * 0.9 + hover * 1.2;

            context.beginPath();
            context.moveTo(x, y - lineHeight * 0.5);
            context.lineTo(x, y + lineHeight * 0.5);
            context.lineWidth = lineWidth;
            context.lineCap = 'round';
            context.strokeStyle = hover > 0.55
              ? `rgba(241, 216, 75, ${0.22 + intensity * 0.72})`
              : `rgba(104, 215, 255, ${0.07 + intensity * 0.58})`;
            context.shadowBlur = intensity * 18;
            context.shadowColor = hover > 0.55 ? '#f1d84b' : '#68d7ff';
            context.stroke();
          }
        }

        context.shadowBlur = 0;
        if (running && !reducedMotion) frameId = requestAnimationFrame(draw);
      };

      const parent = field.parentElement;
      parent?.addEventListener('pointermove', (event) => {
        const rect = field.getBoundingClientRect();
        targetX = event.clientX - rect.left;
        targetY = event.clientY - rect.top;
      }, { passive: true });

      parent?.addEventListener('pointerleave', () => {
        targetX = width * 0.68;
        targetY = height * 0.52;
      });

      const observer = new IntersectionObserver(([entry]) => {
        running = entry.isIntersecting;
        if (running && !reducedMotion) {
          cancelAnimationFrame(frameId);
          frameId = requestAnimationFrame(draw);
        }
      });

      observer.observe(field);
      window.addEventListener('resize', resize);
      resize();
      targetX = width * 0.68;
      targetY = height * 0.5;
      if (!reducedMotion) frameId = requestAnimationFrame(draw);
    }
  }
</script>

<style>
  .hover-field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(circle at 68% 52%, rgba(104, 215, 255, 0.08), transparent 22rem),
      #050506;
    pointer-events: none;
  }

  .hover-field canvas {
    width: 100%;
    height: 100%;
  }

  .field-vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(5, 5, 6, 0.96) 0%, rgba(5, 5, 6, 0.62) 36%, rgba(5, 5, 6, 0.1) 68%, rgba(5, 5, 6, 0.7) 100%),
      linear-gradient(180deg, rgba(5, 5, 6, 0.16), rgba(5, 5, 6, 0.92) 100%);
  }
</style>
