---
import portrait from '../images/user.jpg';
import { profile } from '../data.js';

const capabilities = [
  {
    number: '01',
    title: 'Backend Systems',
    description: 'APIs, authentication, asynchronous services, databases, and realtime communication designed as one dependable system.',
    tools: ['Python', 'FastAPI', 'PostgreSQL', 'MongoDB', 'WebSockets'],
  },
  {
    number: '02',
    title: 'Applied AI',
    description: 'Voice agents, retrieval workflows, tool calling, and automation shaped around a real user task rather than a model demo.',
    tools: ['Gemini', 'LangGraph', 'LiveKit', 'RAG', 'MCP'],
  },
  {
    number: '03',
    title: 'Computer Vision',
    description: 'Detection, face embeddings, image retrieval, and camera pipelines that turn visual data into searchable information.',
    tools: ['OpenCV', 'Dlib', 'YOLO', 'NumPy'],
  },
];
---

<section class="focus-section section-shell" id="focus">
  <div class="container">
    <header class="focus-head">
      <div>
        <p class="eyebrow">About & Focus</p>
    <h2>Build. Ship. Improve.</h2>
      </div>

      <div class="focus-about">
        <img src={portrait.src} alt="Portrait of Lawrence Dsouza" width={portrait.width} height={portrait.height} loading="lazy" />
        <div>
          <p>{profile.summary}</p>
          <span>{profile.location} · Open to work</span>
        </div>
      </div>
    </header>

    <div class="capability-list">
      {capabilities.map((capability) => (
        <article>
          <span class="capability-number">{capability.number}</span>
          <h3>{capability.title}</h3>
          <p>{capability.description}</p>
          <div aria-label={'Technologies for ' + capability.title}>
            {capability.tools.map((tool) => <span>{tool}</span>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .focus-section {
    overflow: hidden;
    background:
      radial-gradient(circle at 85% 20%, rgba(30, 144, 255, 0.08), transparent 24rem),
      radial-gradient(circle at 12% 80%, rgba(0, 255, 133, 0.035), transparent 22rem),
      var(--color-secondary);
  }

  .focus-head {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.65fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: end;
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .focus-head h2 {
    max-width: 800px;
    margin-top: 1.2rem;
    font-size: clamp(3rem, 6.8vw, 6.2rem);
    line-height: 0.92;
  }

  .focus-about {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1.25rem;
    align-items: start;
  }

  .focus-about img {
    width: 5.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
  }

  .focus-about p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .focus-about span {
    display: block;
    margin-top: 0.8rem;
    color: var(--color-signal);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .capability-list {
    border-top: 1px solid var(--color-border-strong);
  }

  .capability-list article {
    display: grid;
    grid-template-columns: 4rem minmax(170px, 0.65fr) minmax(240px, 1.15fr) minmax(220px, 0.8fr);
    gap: clamp(1.25rem, 3vw, 2.8rem);
    align-items: center;
    min-height: 9rem;
    padding: 1.7rem 0;
    border-bottom: 1px solid var(--color-border);
    transition: padding var(--transition-normal), background var(--transition-normal);
  }

  .capability-list article:hover {
    padding-left: 1rem;
    padding-right: 1rem;
    background: rgba(255, 255, 255, 0.025);
  }

  .capability-number {
    color: var(--color-accent);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .capability-list h3 {
    font-size: clamp(1.55rem, 3vw, 2.4rem);
  }

  .capability-list p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .capability-list article > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.42rem;
    justify-content: flex-end;
  }

  .capability-list article > div span {
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    font-size: 0.66rem;
  }

  @media (max-width: 860px) {
    .focus-head {
      grid-template-columns: 1fr;
    }

    .capability-list article {
      grid-template-columns: 3rem 1fr;
    }

    .capability-list article > p,
    .capability-list article > div {
      grid-column: 2;
    }

    .capability-list article > div {
      justify-content: flex-start;
    }
  }

  @media (max-width: 520px) {
    .focus-about {
      grid-template-columns: 4.5rem 1fr;
    }

    .focus-about img {
      width: 4.5rem;
    }

    .capability-list article {
      grid-template-columns: 1fr;
      gap: 0.9rem;
      padding: 2rem 0;
    }

    .capability-list article > p,
    .capability-list article > div {
      grid-column: 1;
    }
  }
</style>
