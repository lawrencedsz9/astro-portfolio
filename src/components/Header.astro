---
import logo from '../images/user.jpg';
import { profile } from '../data.js';

const pathname = Astro.url.pathname;

const navItems = [
  { label: 'Home', href: '/#home' },
  { label: 'About', href: '/#about' },
  { label: 'Projects', href: '/#projects' },
  { label: 'Contact', href: '/#contact' },
];

// Section links all live on the home page, so only Home lights up there;
// the standalone /about and /contact routes map to their own pills.
const activeHref = pathname.startsWith('/about')
  ? '/#about'
  : pathname.startsWith('/contact')
    ? '/#contact'
    : '/#home';
---

<header class="pillbar">
  <div class="pillbar-inner">
    <a href="/#home" class="pill-logo" aria-label="Go to home">
      <img src={logo.src} alt="Lawrence Dsouza" width="40" height="40" />
    </a>

    <nav class="pill-nav" id="site-nav" aria-label="Main navigation">
      <ul>
        {navItems.map((item) => (
          <li>
            <a
              class:list={['pill', item.href === activeHref && 'is-active']}
              href={item.href}
            >
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="pill-cta" href={'mailto:' + profile.email}>Email</a>

    <button class="pill-burger" type="button" aria-label="Toggle menu" aria-controls="site-nav" aria-expanded="false">
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const menuBtn = document.querySelector('.pill-burger');
    const nav = document.querySelector('.pill-nav');

    const setMenuOpen = (open: boolean) => {
      menuBtn?.classList.toggle('open', open);
      nav?.classList.toggle('open', open);
      document.body.classList.toggle('menu-open', open);

      if (menuBtn instanceof HTMLButtonElement) {
        menuBtn.setAttribute('aria-expanded', String(open));
      }
    };

    menuBtn?.addEventListener('click', () => {
      setMenuOpen(!menuBtn.classList.contains('open'));
    });

    nav?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false));
    });
  });
</script>

<style>
  .pillbar {
    position: fixed;
    top: 1rem;
    left: 0;
    right: 0;
    z-index: 1000;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .pillbar-inner {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: max-content;
    max-width: min(100% - 1.5rem, 1100px);
    padding: 6px;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    background: rgba(6, 7, 18, 0.72);
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.34);
    backdrop-filter: blur(18px);
    pointer-events: auto;
  }

  /* Logo circle */
  .pill-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    flex: 0 0 auto;
    padding: 3px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 50%;
    background: var(--color-secondary);
    overflow: hidden;
  }

  .pill-logo img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .pill-logo:hover img,
  .pill-logo:focus-visible img {
    transform: scale(1.08) rotate(4deg);
  }

  /* Pill list */
  .pill-nav ul {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    padding: 0;
  }

  .pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 46px;
    padding: 0 20px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
  }

  .pill span {
    position: relative;
    z-index: 2;
    transition: color var(--transition-normal);
  }

  /* Signature "circle grows to fill the pill" hover — pure CSS. */
  .pill::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 130%;
    aspect-ratio: 1;
    transform: translate(-50%, 62%) scale(0);
    transform-origin: center bottom;
    border-radius: 50%;
    background: var(--color-accent-mint);
    z-index: 1;
    transition: transform var(--transition-normal);
  }

  .pill:hover::before,
  .pill:focus-visible::before {
    transform: translate(-50%, 22%) scale(1.7);
  }

  .pill:hover span,
  .pill:focus-visible span {
    color: var(--color-primary);
  }

  .pill.is-active {
    background: var(--color-accent-mint);
    color: var(--color-primary);
  }

  .pill.is-active span {
    color: var(--color-primary);
  }

  /* Email CTA */
  .pill-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 46px;
    padding: 0 18px;
    flex: 0 0 auto;
    border-radius: 9999px;
    border: 1px solid rgba(128, 237, 153, 0.34);
    background: rgba(128, 237, 153, 0.1);
    color: var(--color-accent-mint);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .pill-cta:hover,
  .pill-cta:focus-visible {
    background: var(--color-accent-mint);
    color: var(--color-primary);
  }

  /* Hamburger — hidden on desktop */
  .pill-burger {
    display: none;
    width: 46px;
    height: 46px;
    flex: 0 0 auto;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    cursor: pointer;
  }

  .pill-burger .bar {
    display: block;
    width: 17px;
    height: 2px;
    border-radius: 99px;
    background: var(--color-text);
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  .pill-burger.open .bar:nth-child(1) {
    transform: translateY(3.5px) rotate(45deg);
  }

  .pill-burger.open .bar:nth-child(2) {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  @media (max-width: 820px) {
    .pillbar {
      top: 0.75rem;
    }

    .pillbar-inner {
      width: calc(100% - 1.5rem);
      justify-content: space-between;
    }

    .pill-cta {
      display: none;
    }

    .pill-burger {
      display: inline-flex;
    }

    /* Nav becomes a dropdown popover */
    .pill-nav {
      position: absolute;
      top: calc(100% + 0.55rem);
      left: 0;
      right: 0;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.5rem);
      transition: opacity var(--transition-fast), transform var(--transition-fast), visibility var(--transition-fast);
    }

    .pill-nav.open {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .pill-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 5px;
      padding: 6px;
      border: 1px solid var(--color-border);
      border-radius: 22px;
      background: rgba(6, 7, 18, 0.96);
      box-shadow: var(--shadow-md);
      backdrop-filter: blur(18px);
    }

    .pill {
      justify-content: flex-start;
      width: 100%;
      height: 3rem;
    }
  }
</style>
