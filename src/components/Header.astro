---
import { profile } from '../data.js';

const navItems = [
  { label: 'My Projects', note: 'Systems and products I have built.', href: '/#projects' },
  { label: 'About Me', note: 'How I think and what I work with.', href: '/#focus' },
  { label: 'Contact', note: profile.email, href: '/#contact' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href="/#home">Lawrence <span>Dsouza</span></a>

    <button class="menu-toggle" type="button" aria-label="Toggle navigation" aria-controls="site-nav" aria-expanded="false">
      <span></span><span></span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Main navigation">
      {navItems.map((item) => (
        <a href={item.href}>
          <strong>{item.label} <span aria-hidden="true">↗</span></strong>
          <small>{item.note}</small>
        </a>
      ))}
      <div class="socials">
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const navigation = document.querySelector('.site-nav');

  const setOpen = (open: boolean) => {
    toggle?.classList.toggle('is-open', open);
    navigation?.classList.toggle('is-open', open);
    document.body.classList.toggle('menu-open', open);
    if (toggle instanceof HTMLButtonElement) toggle.setAttribute('aria-expanded', String(open));
  };

  toggle?.addEventListener('click', () => setOpen(!navigation?.classList.contains('is-open')));
  navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    border-bottom: 1px solid var(--color-border);
    background: rgba(5, 5, 6, 0.86);
    backdrop-filter: blur(20px);
  }

  .header-inner {
    display: grid;
    grid-template-columns: minmax(180px, 0.8fr) minmax(0, 2.2fr);
    gap: 3rem;
    min-height: 7rem;
    align-items: start;
    padding-top: 1.25rem;
    padding-bottom: 1rem;
  }

  .wordmark {
    width: fit-content;
    padding-bottom: 0.15rem;
    border-bottom: 2px solid var(--color-text);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .wordmark span {
    color: var(--color-accent);
  }

  .site-nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(130px, 1fr));
    gap: 1.5rem 2rem;
  }

  .site-nav > a {
    display: grid;
    gap: 0.2rem;
  }

  .site-nav strong {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.94rem;
    line-height: 1.2;
  }

  .site-nav strong span {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .site-nav small {
    max-width: 20ch;
    color: var(--color-text-muted);
    font-size: 0.7rem;
    line-height: 1.4;
  }

  .socials {
    grid-column: 1 / -1;
    display: flex;
    gap: 1.8rem;
    font-size: 0.7rem;
    font-weight: 600;
  }

  .site-nav a:hover strong,
  .site-nav a:focus-visible strong,
  .socials a:hover,
  .socials a:focus-visible {
    color: var(--color-accent);
  }

  .menu-toggle {
    display: none;
    width: 2.8rem;
    height: 2.8rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    background: transparent;
  }

  .menu-toggle span {
    display: block;
    width: 1.15rem;
    height: 1px;
    margin: 0.32rem auto;
    background: var(--color-text);
    transition: transform var(--transition-fast);
  }

  @media (max-width: 820px) {
    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 4.7rem;
      padding-top: 0;
      padding-bottom: 0;
    }

    .menu-toggle {
      display: block;
    }

    .menu-toggle.is-open span:first-child {
      transform: translateY(2.6px) rotate(45deg);
    }

    .menu-toggle.is-open span:last-child {
      transform: translateY(-2.6px) rotate(-45deg);
    }

    .site-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: none;
      grid-template-columns: 1fr;
      gap: 0;
      padding: 0.5rem 1rem 1.2rem;
      border-bottom: 1px solid var(--color-border);
      background: rgba(5, 5, 6, 0.97);
    }

    .site-nav.is-open {
      display: grid;
    }

    .site-nav > a {
      padding: 1rem 0;
      border-bottom: 1px solid var(--color-border);
    }

    .socials {
      grid-column: auto;
      padding-top: 1rem;
    }
  }
</style>
