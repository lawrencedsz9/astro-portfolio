---
import { projects } from '../data.js';

type Project = {
  name: string;
  category: string;
  period: string;
  description: string;
  highlight: string;
  link: string;
  stack: string[];
};

const typedProjects = projects as Project[];
const featuredProjects = typedProjects.slice(0, 2);
const otherProjects = typedProjects.slice(2);
---

<section class="projects-section section-shell" id="projects">
  <div class="container">
    <header class="projects-head">
      <p class="eyebrow">Selected work</p>
      <h2>Products, systems, and experiments I have built.</h2>
      <p>The interesting part is not the technology list. It is how the pieces were made to work together.</p>
    </header>

    <div class="featured-projects">
      {featuredProjects.map((project, index) => (
        <article class="featured-project">
          <p class="project-category">{project.category}</p>
          <h3>{project.name}</h3>
          <time>{project.period}</time>
          <p class="project-description">{project.description}</p>
          <p class="project-highlight">{project.highlight}</p>

          <div class="featured-stack" aria-label={'Technology used for ' + project.name}>
            {project.stack.map((technology) => <span>{technology}</span>)}
          </div>

          <a href={project.link} target="_blank" rel="noopener noreferrer">
            Repository <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>

    <div class="other-work">
      <div class="other-work-heading">
        <p class="eyebrow">Other work</p>
        <p>Four more projects across computer vision, mobile, and product engineering.</p>
      </div>

      <div class="project-list">
        {otherProjects.map((project, index) => (
          <a class="project-row" href={project.link} target="_blank" rel="noopener noreferrer">
            <span class="row-number">{String(index + 3).padStart(2, '0')}</span>
            <div class="row-main">
              <p>{project.category}</p>
              <h3>{project.name}</h3>
              <p class="row-description">{project.description}</p>
              <p class="row-highlight">{project.highlight}</p>
            </div>
            <div class="row-meta">
              <span>{project.stack.join(' · ')}</span>
              <strong aria-hidden="true">↗</strong>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .projects-section {
    overflow: hidden;
    background:
      radial-gradient(circle at 10% 24%, rgba(0, 255, 133, 0.04), transparent 26rem),
      radial-gradient(circle at 88% 70%, rgba(30, 144, 255, 0.06), transparent 28rem),
      var(--color-primary);
  }

  .projects-head {
    display: grid;
    grid-template-columns: minmax(110px, 0.3fr) minmax(0, 1.2fr) minmax(220px, 0.5fr);
    gap: 2rem;
    align-items: end;
    padding-bottom: clamp(3rem, 7vw, 5.5rem);
  }

  .projects-head h2 {
    max-width: 760px;
    font-size: clamp(3rem, 6.8vw, 6.2rem);
    line-height: 0.92;
  }

  .projects-head > p:last-child {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .featured-projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .featured-project {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 31rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--color-border);
    border-radius: 0 var(--border-radius-lg) var(--border-radius-lg) var(--border-radius-lg);
    background:
      radial-gradient(circle at 84% 10%, rgba(255, 255, 255, 0.055), transparent 15rem),
      rgba(8, 8, 8, 0.97);
    overflow: hidden;
    transition: transform var(--transition-normal), border-color var(--transition-normal);
  }

  .featured-project::after {
    content: '';
    position: absolute;
    top: -8rem;
    right: -7rem;
    width: 20rem;
    height: 20rem;
    border-radius: 50%;
    background: var(--color-text);
    filter: blur(110px);
    opacity: 0.08;
    pointer-events: none;
  }

  .featured-project:nth-child(2)::after {
    background: var(--color-signal);
  }

  .featured-project:hover,
  .featured-project:focus-within {
    transform: translateY(-5px);
    border-color: rgba(255, 255, 255, 0.38);
  }

  .featured-project:nth-child(2):hover,
  .featured-project:nth-child(2):focus-within {
    border-color: rgba(255, 0, 153, 0.48);
  }

  .project-category {
    position: relative;
    z-index: 1;
    margin: 0 0 0.55rem;
    color: var(--color-text-muted);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .featured-project:nth-child(1) .project-category,
  .featured-project:nth-child(1) h3,
  .featured-project:nth-child(1) > a {
    color: var(--color-text);
  }

  .featured-project:nth-child(2) .project-category,
  .featured-project:nth-child(2) h3,
  .featured-project:nth-child(2) > a {
    color: var(--color-signal);
  }

  .featured-project h3 {
    position: relative;
    z-index: 1;
    max-width: 18ch;
    min-height: 2.05em;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 0.98;
  }

  .featured-project time {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    margin: 1.5rem 0 0;
    padding: 0.42rem 0.8rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    color: var(--color-text-muted);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  .project-description {
    position: relative;
    z-index: 1;
    margin: 1.25rem 0 0;
    color: var(--color-text);
    font-size: clamp(1rem, 1.7vw, 1.15rem);
    line-height: 1.7;
  }

  .project-highlight {
    position: relative;
    z-index: 1;
    margin: 0.9rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    line-height: 1.7;
  }

  .featured-stack {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: auto;
    padding-top: 1.7rem;
  }

  .featured-stack span {
    padding: 0.3rem 0.58rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text);
    font-size: 0.68rem;
    font-weight: 600;
  }

  .featured-project > a {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    margin-top: 1.25rem;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .other-work {
    padding-top: clamp(5rem, 10vw, 8rem);
  }

  .other-work-heading {
    display: grid;
    grid-template-columns: minmax(110px, 0.3fr) minmax(0, 1.7fr);
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .other-work-heading > p:last-child {
    max-width: 540px;
    margin: 0;
    color: var(--color-text-muted);
  }

  .project-list {
    border-top: 1px solid var(--color-border-strong);
  }

  .project-row {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1.4fr) minmax(180px, 0.6fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: 2.2rem 0;
    border-bottom: 1px solid var(--color-border);
    transition: background var(--transition-normal), padding var(--transition-normal);
  }

  .project-row:hover,
  .project-row:focus-visible {
    padding-left: 1rem;
    padding-right: 1rem;
    background: rgba(255, 255, 255, 0.025);
  }

  .row-number,
  .row-main > p:first-child,
  .row-meta {
    color: var(--color-text-muted);
    font-size: 0.7rem;
  }

  .row-main > p:first-child {
    margin: 0 0 0.5rem;
    color: var(--color-accent);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .row-main h3 {
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    line-height: 1.05;
  }

  .row-description {
    max-width: 720px;
    margin: 0.8rem 0 0;
    line-height: 1.6;
  }

  .row-highlight {
    max-width: 720px;
    margin: 0.6rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.84rem;
    line-height: 1.65;
  }

  .row-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
    text-align: right;
    line-height: 1.6;
  }

  .row-meta strong {
    color: var(--color-signal);
    font-size: 1.4rem;
    font-weight: 400;
  }

  @media (max-width: 820px) {
    .projects-head {
      grid-template-columns: 1fr;
    }

    .featured-projects {
      grid-template-columns: 1fr;
    }

    .featured-project {
      min-height: 28rem;
    }
  }

  @media (max-width: 620px) {
    .other-work-heading,
    .project-row {
      grid-template-columns: 1fr;
    }

    .project-row {
      gap: 0.75rem;
    }

    .row-number {
      display: none;
    }

    .row-meta {
      align-items: flex-start;
      gap: 1rem;
      text-align: left;
    }
  }
</style>
