---
import { projects } from '../data.js';

type Project = {
  name: string;
  category: string;
  period: string;
  description: string;
  highlight: string;
  link: string;
  stack: string[];
};

const typedProjects = projects as Project[];
const tones = ['cool', 'mint', 'coral', 'violet'];
---

<section class="projects-section section-shell" id="projects">
  <div class="container">
    <header class="projects-head">
      <p class="eyebrow">Selected Work</p>
      <h2>Projects I've worked on</h2>
    </header>

    <div class="projects-grid">
      {typedProjects.map((project, index) => {
        const tone = tones[index % tones.length];

        return (
          <a
            class={'project-card tone-' + tone}
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={'Open ' + project.name + ' repository'}
          >
            <div class="pc-top">
              <span class="pc-category">{project.category}</span>
              <span class="pc-period">{project.period}</span>
            </div>

            <h3 class="pc-title">{project.name}</h3>
            <p class="pc-desc">{project.description}</p>

            <div class="pc-tags" aria-label={'Tech stack for ' + project.name}>
              {project.stack.map((tech) => <span>{tech}</span>)}
            </div>

            <span class="pc-link">
              View repository <span aria-hidden="true">↗</span>
            </span>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .projects-section {
    background:
      linear-gradient(180deg, rgba(6, 7, 18, 0.94), rgba(10, 12, 20, 0.98)),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.03) 0 1px, transparent 1px 5rem);
  }

  .projects-head {
    max-width: 640px;
    margin-bottom: 3rem;
  }

  .projects-head h2 {
    margin-top: 0.25rem;
    font-size: 3rem;
  }

  .projects-lede {
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    font-size: 1.06rem;
    line-height: 1.7;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    column-gap: 1.5rem;
    row-gap: 1.75rem;
  }

  /* Minimal, typographic cards — transparent by default, soft panel on hover. */
  .project-card {
    --tone: var(--color-accent-cool);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid transparent;
    border-radius: var(--border-radius-md);
    background: transparent;
    transition: transform var(--transition-normal), border-color var(--transition-normal), background var(--transition-normal);
  }

  .project-card:hover,
  .project-card:focus-visible {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--tone) 42%, var(--color-border));
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--tone) 8%, transparent), rgba(255, 255, 255, 0.015)),
      rgba(16, 17, 31, 0.6);
  }

  .tone-mint {
    --tone: var(--color-accent-mint);
  }

  .tone-coral {
    --tone: var(--color-accent-coral);
  }

  .tone-violet {
    --tone: var(--color-accent-violet);
  }

  .pc-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .pc-category {
    color: var(--tone);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.76rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .pc-period {
    flex: 0 0 auto;
    padding: 0.32rem 0.7rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-text-muted);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .pc-title {
    max-width: 22ch;
    color: var(--color-text);
    font-size: 1.7rem;
    line-height: 1.15;
    transition: color var(--transition-normal);
  }

  .project-card:hover .pc-title,
  .project-card:focus-visible .pc-title {
    color: var(--tone);
  }

  .pc-desc {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.96rem;
    line-height: 1.65;
  }

  .pc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.1rem;
  }

  .pc-tags span {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--border-radius-sm);
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-text-muted);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .pc-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.25rem;
    color: var(--tone);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity var(--transition-normal), transform var(--transition-normal);
  }

  .project-card:hover .pc-link,
  .project-card:focus-visible .pc-link {
    opacity: 1;
    transform: translateY(0);
  }

  @media (hover: none) {
    .pc-link {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 820px) {
    .projects-head h2 {
      font-size: 2.4rem;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .project-card {
      padding: 1.35rem;
    }
  }

  @media (max-width: 480px) {
    .projects-head h2 {
      font-size: 2rem;
    }

    .pc-title {
      font-size: 1.45rem;
    }
  }
</style>
