---
import { projects } from '../data.js';

type Project = {
  name: string;
  category: string;
  period: string;
  description: string;
  highlight: string;
  link: string;
  stack: string[];
};

const typedProjects = projects as Project[];
const tones = ['cool', 'mint', 'coral', 'violet'];

// Turn a GitHub URL into a terminal-style path, e.g. ~/lawrencedsz9/WMS
const repoPath = (link: string) => {
  try {
    const path = new URL(link).pathname.replace(/^\/+|\/+$/g, '');
    return path ? '~/' + path : '~/projects';
  } catch {
    return '~/projects';
  }
};
---

<section class="projects-section section-shell" id="projects">
  <div class="container">
    <header class="projects-head">
      <p class="eyebrow">Selected Work</p>
      <h2>Projects I've worked on</h2>
    </header>

    <div class="projects-grid" data-projects-grid>
      {typedProjects.map((project, index) => {
        const tone = tones[index % tones.length];

        return (
          <a
            class={'project-card tone-' + tone}
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={'Open ' + project.name + ' repository'}
          >
            <div class="pc-chrome">
              <span class="pc-dots" aria-hidden="true">
                <i></i><i></i><i></i>
              </span>
              <span class="pc-path">{repoPath(project.link)}</span>
            </div>

            <div class="pc-body">
              <div class="pc-top">
                <span class="pc-category">{project.category}</span>
                <span class="pc-period">{project.period}</span>
              </div>

              <h3 class="pc-title">{project.name}</h3>
              <p class="pc-desc">{project.description}</p>

              <div class="pc-tags" aria-label={'Tech stack for ' + project.name}>
                {project.stack.map((tech) => <span>{tech}</span>)}
              </div>

              <span class="pc-link">
                <span class="pc-prompt">&gt;</span> view repository <span aria-hidden="true">↗</span>
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<script>
  // Cursor-following glow: each card tracks the pointer via CSS custom props.
  const grid = document.querySelector('[data-projects-grid]');

  if (grid instanceof HTMLElement && window.matchMedia('(hover: hover)').matches) {
    grid.addEventListener(
      'pointermove',
      (e) => {
        const card = (e.target as Element).closest('.project-card');
        if (card instanceof HTMLElement) {
          const rect = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${e.clientX - rect.left}px`);
          card.style.setProperty('--my', `${e.clientY - rect.top}px`);
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  .projects-section {
    background:
      linear-gradient(180deg, rgba(6, 7, 18, 0.94), rgba(10, 12, 20, 0.98)),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.03) 0 1px, transparent 1px 5rem);
  }

  .projects-head {
    max-width: 640px;
    margin-bottom: 3rem;
  }

  .projects-head h2 {
    margin-top: 0.25rem;
    font-size: 3rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    column-gap: 1.5rem;
    row-gap: 1.75rem;
  }

  /* --- Terminal window card --- */
  .project-card {
    --tone: var(--color-accent-cool);
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    background: rgba(9, 11, 20, 0.85);
    overflow: hidden;
    transition: transform var(--transition-normal), border-color var(--transition-normal);
  }

  /* Cursor-following glow layer */
  .project-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0;
    background: radial-gradient(
      240px circle at var(--mx, 50%) var(--my, 0%),
      color-mix(in srgb, var(--tone) 18%, transparent),
      transparent 70%
    );
    transition: opacity var(--transition-normal);
    pointer-events: none;
  }

  .project-card:hover,
  .project-card:focus-visible {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--tone) 50%, var(--color-border));
  }

  .project-card:hover::before,
  .project-card:focus-visible::before {
    opacity: 1;
  }

  .tone-mint {
    --tone: var(--color-accent-mint);
  }

  .tone-coral {
    --tone: var(--color-accent-coral);
  }

  .tone-violet {
    --tone: var(--color-accent-violet);
  }

  /* Window chrome bar */
  .pc-chrome {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.02);
  }

  .pc-dots {
    display: inline-flex;
    gap: 0.4rem;
    flex: 0 0 auto;
  }

  .pc-dots i {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
  }

  .pc-dots i:nth-child(1) {
    background: #ff5f57;
  }

  .pc-dots i:nth-child(2) {
    background: #febc2e;
  }

  .pc-dots i:nth-child(3) {
    background: #28c840;
  }

  .pc-path {
    color: var(--color-text-muted);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .project-card:hover .pc-path,
  .project-card:focus-visible .pc-path {
    color: var(--tone);
  }

  /* Card body */
  .pc-body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    flex: 1;
    padding: 1.4rem;
  }

  .pc-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .pc-category {
    color: var(--tone);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .pc-period {
    flex: 0 0 auto;
    padding: 0.3rem 0.65rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-text-muted);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .pc-title {
    max-width: 22ch;
    color: var(--color-text);
    font-size: 1.5rem;
    line-height: 1.18;
    transition: color var(--transition-normal);
  }

  .project-card:hover .pc-title,
  .project-card:focus-visible .pc-title {
    color: var(--tone);
  }

  .pc-desc {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .pc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  .pc-tags span {
    display: inline-flex;
    align-items: center;
    padding: 0.28rem 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--border-radius-sm);
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-text-muted);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.74rem;
    font-weight: 700;
  }

  .pc-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--tone);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    opacity: 0.55;
    transition: opacity var(--transition-normal);
  }

  .pc-prompt {
    color: var(--tone);
    font-weight: 800;
  }

  .project-card:hover .pc-link,
  .project-card:focus-visible .pc-link {
    opacity: 1;
  }

  @media (max-width: 820px) {
    .projects-head h2 {
      font-size: 2.4rem;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .projects-head h2 {
      font-size: 2rem;
    }

    .pc-title {
      font-size: 1.35rem;
    }
  }
</style>
