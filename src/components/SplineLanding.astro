---
import { profile } from '../data.js';

export interface Props {
  heading?: string;
  text?: string;
  tags?: string[];
  showExtra?: boolean;
}

const {
  heading = profile.hero.heading,
  text = profile.hero.text,
  tags = profile.hero.tags,
  showExtra = false,
} = Astro.props as Props;
---

<section class="spline-landing" id="home">
  <div class="container hero-container">
    <div class="hero-copy">
      <div class="hero-kicker">
        <span>{profile.role}</span>
        <span>{profile.location}</span>
      </div>

      <h1>{heading}</h1>
      <p class="hero-line">Backend systems. AI applications. Realtime products.</p>
      <p class="subtitle">{text}</p>

      <div class="tags-container" aria-label="Core skills">
        {tags.map((tag, index) => (
          <span class={'tag tone-' + (index % 4)}>{tag}</span>
        ))}
      </div>

      {showExtra && (
        <div class="landing-cta">
          <a href="#projects" class="btn btn-primary">View projects <span aria-hidden="true">-&gt;</span></a>
          <a href={'mailto:' + profile.email} class="btn btn-outline">Start a conversation</a>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .spline-landing {
    min-height: 92svh;
    display: flex;
    align-items: center;
    position: relative;
    z-index: 1;
    padding: 8.5rem 0 3.5rem;
    overflow: hidden;
  }

  .hero-container {
    display: grid;
    gap: 3rem;
  }

  .hero-copy {
    width: min(760px, 100%);
    display: grid;
    gap: 1.25rem;
    animation: fadeInUp 0.7s ease both;
  }

  .hero-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    color: var(--color-text-muted);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.86rem;
    font-weight: 800;
  }

  .hero-kicker span {
    display: inline-flex;
    min-height: 2.1rem;
    align-items: center;
    padding: 0.42rem 0.62rem;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    background: rgba(255, 255, 255, 0.045);
  }

  h1 {
    max-width: 8.8ch;
    font-size: 5.8rem;
    line-height: 0.96;
    color: var(--color-text);
    overflow-wrap: break-word;
  }

  .hero-line {
    margin: 0;
    color: var(--color-accent-mint);
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1.22;
  }

  .subtitle {
    max-width: 620px;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1.12rem;
    line-height: 1.7;
  }

  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 0.3rem;
  }

  .tag {
    --tag-color: var(--color-accent-cool);
    display: inline-flex;
    min-height: 2.35rem;
    align-items: center;
    padding: 0.55rem 0.72rem;
    border: 1px solid color-mix(in srgb, var(--tag-color) 38%, transparent);
    border-radius: var(--border-radius-sm);
    background: color-mix(in srgb, var(--tag-color) 10%, transparent);
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .tone-1 {
    --tag-color: var(--color-accent-mint);
  }

  .tone-2 {
    --tag-color: var(--color-accent-coral);
  }

  .tone-3 {
    --tag-color: var(--color-accent-violet);
  }

  .landing-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 0.35rem;
  }

  @media (max-width: 980px) {
    .spline-landing {
      min-height: 94svh;
      align-items: flex-end;
      padding: 7.2rem 0 2.5rem;
    }

    h1 {
      max-width: 9.5ch;
      font-size: 4.3rem;
    }

    .hero-line {
      font-size: 1.25rem;
    }
  }

  @media (max-width: 560px) {
    .spline-landing {
      padding-top: 6.6rem;
    }

    .hero-container {
      gap: 2rem;
    }

    h1 {
      max-width: 8.6ch;
      font-size: 3.1rem;
    }

    .hero-line {
      font-size: 1.06rem;
    }

    .subtitle {
      font-size: 1rem;
    }
  }
</style>
