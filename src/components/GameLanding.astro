---
import BoxesBackground from './BoxesBackground.astro';
import { profile } from '../data.js';
---

<section class="hero" id="home">
  <BoxesBackground />

  <div class="container hero-inner">
    <h1 aria-label="Lawrence Dsouza">
      <span>Lawrence</span>
      <span>Dsouza</span>
    </h1>

    <div class="hero-intro">
      <div>
        <p class="hero-role">Software Engineer</p>
        <p>{profile.hero.text}</p>
      </div>
    </div>

    <a class="scroll-link" href="#projects" aria-label="Scroll to selected work">
      <span aria-hidden="true">↓</span>
      <strong>[ LET’S SCROLL ]</strong>
      <span aria-hidden="true">↓</span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-primary);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-top: clamp(8.5rem, 16vh, 10.5rem);
    padding-bottom: 2rem;
  }

  h1 {
    display: grid;
    align-content: center;
    font-size: clamp(4.8rem, 12.5vw, 10.6rem);
    font-weight: 700;
    line-height: 0.76;
    letter-spacing: -0.085em;
    text-transform: uppercase;
    text-shadow: 0 8px 40px rgba(0, 0, 0, 0.46);
  }

  h1 span:last-child {
    margin-left: clamp(1rem, 12vw, 9rem);
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.86);
    text-stroke: 1.5px rgba(255, 255, 255, 0.86);
  }

  .hero-intro {
    max-width: 860px;
    margin: clamp(3rem, 7vh, 5rem) auto 0;
  }

  .hero-intro > div:first-child {
    max-width: 600px;
  }

  .hero-intro p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: clamp(0.92rem, 1.4vw, 1.05rem);
    line-height: 1.65;
  }

  .hero-intro .hero-role {
    margin-bottom: 0.55rem;
    color: var(--color-text);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .scroll-link {
    display: inline-flex;
    align-items: center;
    align-self: center;
    gap: 0;
    margin-top: auto;
    padding: 1rem 0 0.25rem;
    color: var(--color-text);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .scroll-link strong {
    color: var(--color-signal);
    transition: color var(--transition-fast);
  }

  .scroll-link:hover strong,
  .scroll-link:focus strong,
  .scroll-link:active strong {
    color: var(--color-text);
  }

  .scroll-link span {
    display: inline-block;
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    white-space: nowrap;
    color: var(--color-text);
    transform: translateY(-4px);
    transition: max-width var(--transition-normal), margin var(--transition-normal), opacity var(--transition-fast), transform var(--transition-fast), color var(--transition-fast);
  }

  .scroll-link:hover span,
  .scroll-link:focus span,
  .scroll-link:active span {
    max-width: 1rem;
    margin: 0 0.65rem;
    opacity: 1;
    color: var(--color-accent);
    transform: translateY(2px);
  }

  @media (max-width: 760px) {
    .hero-inner {
      padding-top: 8rem;
    }

    h1 {
      font-size: clamp(4.2rem, 19vw, 7.6rem);
      line-height: 0.82;
    }

    h1 span:last-child {
      margin-left: 0;
    }

    .hero-intro {
      margin-left: 0;
    }

  }

  @media (max-width: 430px) {
    h1 {
      font-size: 3.85rem;
    }

  }
</style>
