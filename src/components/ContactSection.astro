---
import { profile } from '../data.js';
---

<section class="contact-section section-shell" id="contact">
  <div class="container contact-layout">
    <div class="contact-copy">
      <p class="eyebrow">Contact</p>
      <h2>Need a backend, AI, or automation build?</h2>
      <p>
        I am open to software engineering roles, internships, and project work involving backend APIs, AI applications, realtime systems, and computer vision workflows.
      </p>
    </div>

    <div class="contact-actions" aria-label="Contact links">
      <a class="primary-action" href={'mailto:' + profile.email}>
        <span>Email</span>
        <strong>{profile.email}</strong>
      </a>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">
        <span>LinkedIn</span>
        <strong>Connect professionally</strong>
      </a>
      <a href={profile.github} target="_blank" rel="noopener noreferrer">
        <span>GitHub</span>
        <strong>Check out my GitHub profile</strong>
      </a>
    </div>
  </div>
</section>

<style>
  .contact-section {
    background:
      linear-gradient(180deg, rgba(6, 7, 18, 0.98), rgba(10, 9, 20, 0.96)),
      linear-gradient(90deg, rgba(128, 237, 153, 0.06), rgba(56, 163, 165, 0.05));
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.76fr);
    gap: 2rem;
    align-items: start;
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.025)),
      rgba(6, 7, 18, 0.72);
    box-shadow: var(--shadow-md);
  }

  .contact-copy h2 {
    max-width: 760px;
    font-size: 3.1rem;
  }

  .contact-copy p:last-child {
    max-width: 700px;
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    font-size: 1.04rem;
    line-height: 1.75;
  }

  .contact-actions {
    display: grid;
    gap: 0.75rem;
  }

  .contact-actions a {
    display: grid;
    gap: 0.35rem;
    min-height: 5.4rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    background: rgba(255, 255, 255, 0.045);
  }

  .contact-actions a:hover,
  .contact-actions a:focus-visible {
    transform: translateY(-3px);
    border-color: var(--color-accent-cool);
  }

  .contact-actions .primary-action {
    border-color: rgba(128, 237, 153, 0.42);
    background: rgba(128, 237, 153, 0.12);
  }

  .contact-actions span {
    color: var(--color-text-muted);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.78rem;
    font-weight: 900;
  }

  .contact-actions strong {
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .contact-meta {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .contact-meta span {
    display: inline-flex;
    min-height: 2.2rem;
    align-items: center;
    padding: 0.42rem 0.62rem;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    color: var(--color-text-muted);
    font-size: 0.84rem;
    font-weight: 800;
  }

  @media (max-width: 860px) {
    .contact-layout {
      grid-template-columns: 1fr;
      padding: 1.3rem;
    }

    .contact-copy h2 {
      font-size: 2.25rem;
    }
  }

  @media (max-width: 460px) {
    .contact-layout {
      padding: 1rem;
    }

    .contact-copy h2 {
      font-size: 1.9rem;
    }
  }
</style>
