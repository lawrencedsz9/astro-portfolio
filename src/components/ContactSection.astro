---
import { profile } from '../data.js';
---

<section class="contact-section" id="contact">
  <div class="container contact-inner">
    <p class="contact-label">Have something difficult to build?</p>
    <h2>Let’s make it work.</h2>
    <p class="contact-copy">I am open to software engineering roles and selected projects involving backend systems, applied AI, realtime products, and computer vision.</p>

    <a class="contact-email" href={'mailto:' + profile.email}>
      {profile.email} <span aria-hidden="true">↗</span>
    </a>

    <div class="contact-links">
      <span>{profile.location}</span>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: clamp(5rem, 11vw, 9rem) 0 2rem;
    border-top: 1px solid var(--color-border);
    background:
      radial-gradient(circle at 78% 20%, rgba(104, 215, 255, 0.08), transparent 26rem),
      var(--color-tertiary);
    color: var(--color-text);
  }

  .contact-label {
    margin: 0;
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h2 {
    margin: 1rem 0 1.5rem;
    color: var(--color-text);
    font-size: clamp(4rem, 11vw, 9rem);
    line-height: 0.88;
  }

  .contact-copy {
    max-width: 650px;
    margin: 0;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 1.7vw, 1.2rem);
    line-height: 1.65;
  }

  .contact-email {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    max-width: 100%;
    margin-top: clamp(3rem, 7vw, 5.5rem);
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--color-border-strong);
    color: var(--color-signal);
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.55rem, 4.6vw, 4rem);
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    margin-top: clamp(4rem, 9vw, 8rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.82rem;
  }

  .contact-links span {
    margin-right: auto;
  }

  .contact-links a:hover,
  .contact-links a:focus-visible {
    color: var(--color-accent);
  }

  @media (max-width: 520px) {
    .contact-links {
      flex-direction: column;
      gap: 0.8rem;
    }
  }
</style>
