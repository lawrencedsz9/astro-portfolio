---
import { focusAreas, profile, skills } from '../data.js';
import LogoLoop from './LogoLoop.jsx';
---

<section class="about-section section-shell" id="about">
  <div class="container">
    <div class="about-intro">
      <p class="eyebrow">About</p>
      <h2>Backend systems and AI applications.</h2>
      <p class="intro">{profile.summary}</p>
      <p class="about-lede">
        I like building practical software that connects reliable APIs, automation,
        computer vision, and real-time user experiences into products that people can actually use.
      </p>
    </div>

    <div class="focus-grid" aria-label="Engineering focus areas">
      {focusAreas.map((item, index) => (
        <article class={'focus-item tone-' + (index % 4)}>
          <span class="focus-index">{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>

    <div class="stack-section" aria-labelledby="tech-stack-title">
      <div class="stack-heading">
        <p class="eyebrow">Tech Stack</p>
        <h2 id="tech-stack-title">Tech stack I'm familiar with</h2>
      </div>

      <LogoLoop client:load />

      <div class="skills-grid">
        {skills.map((group) => (
          <section class="skill-group" aria-label={group.group}>
            <h3>{group.group}</h3>
            <div class="skill-list">
              {group.items.map((item) => <span>{item}</span>)}
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    background:
      linear-gradient(180deg, rgba(6, 7, 18, 0.15) 0%, rgba(6, 7, 18, 0.82) 22%, rgba(6, 7, 18, 0.94) 100%),
      linear-gradient(90deg, rgba(56, 163, 165, 0.05), rgba(87, 204, 153, 0.04));
  }

  .about-intro {
    display: grid;
    gap: 1.1rem;
    max-width: 760px;
  }

  .about-intro h2 {
    font-size: 2.85rem;
  }

  .intro,
  .about-lede {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1.06rem;
    line-height: 1.75;
  }

  .intro {
    color: var(--color-accent);
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
    margin-top: 3rem;
  }

  .focus-item {
    --focus-color: var(--color-accent-cool);
    min-height: 14rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.2rem;
    border: 1px solid color-mix(in srgb, var(--focus-color) 30%, var(--color-border));
    border-radius: var(--border-radius-md);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--focus-color) 12%, transparent), rgba(255, 255, 255, 0.025)),
      rgba(13, 14, 26, 0.76);
    transition: transform var(--transition-normal), border-color var(--transition-normal);
  }

  .focus-item:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--focus-color) 55%, var(--color-border));
  }

  .focus-index {
    color: var(--focus-color);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.9rem;
    font-weight: 900;
  }

  .focus-item h3 {
    font-size: 1.2rem;
  }

  .focus-item p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .tone-1 {
    --focus-color: var(--color-accent-mint);
  }

  .tone-2 {
    --focus-color: var(--color-accent-coral);
  }

  .tone-3 {
    --focus-color: var(--color-accent-violet);
  }

  .stack-section {
    display: grid;
    gap: 1.8rem;
    margin-top: 4rem;
    padding: 1.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    background:
      linear-gradient(90deg, rgba(56, 163, 165, 0.08), rgba(128, 237, 153, 0.05), rgba(87, 204, 153, 0.06)),
      rgba(6, 7, 18, 0.72);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .stack-heading {
    display: grid;
    gap: 0.45rem;
  }

  .stack-heading h2 {
    font-size: 2.4rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .skill-group {
    min-width: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .skill-group h3 {
    margin-bottom: 0.8rem;
    color: var(--color-accent-mint);
    font-size: 1rem;
  }

  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .skill-list span {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.38rem 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--border-radius-sm);
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-weight: 700;
  }

  @media (max-width: 980px) {
    .focus-grid,
    .skills-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about-intro h2 {
      font-size: 2.3rem;
    }
  }

  @media (max-width: 560px) {
    .focus-grid,
    .skills-grid {
      grid-template-columns: 1fr;
    }

    .about-intro h2,
    .stack-heading h2 {
      font-size: 2rem;
    }

    .focus-item {
      min-height: 0;
    }

    .stack-section {
      padding: 1.1rem;
    }
  }
</style>
