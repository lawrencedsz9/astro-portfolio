---
import Layout from '../layouts/Layout.astro';
import EngineeringFocus from '../components/EngineeringFocus.astro';
import { profile } from '../data.js';
---

<Layout title={'About | ' + profile.name} description={profile.metaDescription}>
  <main class="page-shell">
    <EngineeringFocus />
  </main>
</Layout>

<style>
  .page-shell {
    min-height: 100vh;
    padding-top: 5.5rem;
    background: var(--color-primary);
  }
</style>
